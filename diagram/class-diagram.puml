' Composition – structural ownership
State        *-- "many" Button   : buttons
StateMachine *-- "1"    State    : huidige_staat
FightState   *-- "many" Pokermon : speler_team / ai
Pokermon     *-- "many" Attack   : moves

' Association – service dependencies
StateMachine --> InputManager : uses
StateMachine --> Renderer     : uses

' Dependency – screen navigation
MainMenuState       ..> ChooseState         : play
ChooseState         ..> ChoosePokermonState : fight
ChooseState         ..> BlackjackState      : blackjack
ChooseState         ..> SlotsState          : slots
ChoosePokermonState ..> FightState          : battle

@enduml
